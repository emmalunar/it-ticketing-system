# Application
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
# Set this to the connection URI from Supabase to use Supabase PostgreSQL.
# The URI takes precedence over USE_SQLITE and the POSTGRES_* settings.
SUPABASE_DB_URL=
USE_SQLITE=false
POSTGRES_DB=it_ticketing
POSTGRES_USER=it_ticketing
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Use 0 with the transaction pooler; persistent server connections suit the session pooler.
DB_CONN_MAX_AGE=60

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
# Required only if the object-storage profile is enabled.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=it-ticketing

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api/v1